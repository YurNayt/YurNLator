<?xml version="1.0" encoding="utf-8"?>
<!-- Back: the screen leaves to the right, the way it came in (push_enter). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_linear_in"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="160" />
    <translate android:fromXDelta="0%" android:toXDelta="8%" android:duration="160" />
</set>
