<?xml version="1.0" encoding="utf-8"?>
<!-- Tab switch: short fade with a slight rise. Short and decelerating so the first frames of the
     new screen (when it is still composing) don't show as a stutter. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="170" />
    <translate android:fromYDelta="3%" android:toYDelta="0%" android:duration="170" />
</set>
