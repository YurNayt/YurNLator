<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <ImageButton
        style="@style/ListMenuButton.Square"
        android:id="@+id/BTCopy"
        android:src="@drawable/ui_ic_m_copy"
        android:contentDescription="@string/l_log_copy"
        android:layout_marginRight="8dp" />

    <ImageButton
        style="@style/ListMenuButton.Square"
        android:id="@+id/BTClear"
        android:contentDescription="@string/l_log_clear"
        android:src="@drawable/ui_ic_m_delete"
        android:layout_marginRight="8dp" />

    <ImageButton
        style="@style/ListMenuButton.Square"
        android:id="@+id/BTPause"
        android:contentDescription="@string/l_log_pause"
        android:src="@drawable/ui_ic_m_pause"
        android:layout_marginRight="8dp" />

</LinearLayout>